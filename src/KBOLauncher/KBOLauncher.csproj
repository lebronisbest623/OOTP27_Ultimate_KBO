<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>KBOLauncher</AssemblyName>
    <RootNamespace>KBOLauncher</RootNamespace>
    <BaseOutputPath>..\..\bin\</BaseOutputPath>
    <ApplicationIcon>..\..\assets\icons\kbo-launcher-icon.ico</ApplicationIcon>
    <Version>1.1.2</Version>
    <AssemblyVersion>1.1.2.0</AssemblyVersion>
    <FileVersion>1.1.2.0</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="..\..\data\seeds\**\*.csv" Link="data\seeds\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\data\seeds\**\*.json" Link="data\seeds\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\**\*.*" Link="assets\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\native\bin\KBOFix.dll" Link="KBOFix.dll" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\native\bin\WebView2Loader.dll" Link="WebView2Loader.dll" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\native\kbo_league_id.txt" Link="kbo_league_id.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\tools\kbo_optimizer.exe" Link="tools\kbo_optimizer.exe" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\tools\kbo_optimizer.py" Link="tools\kbo_optimizer.py" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\tools\kbo_optimizer_lib\**\*.py" Link="tools\kbo_optimizer_lib\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
    <PackageReference Include="Polly" Version="8.4.1" />
    <PackageReference Include="Spectre.Console" Version="0.49.1" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>KBOLauncher.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
